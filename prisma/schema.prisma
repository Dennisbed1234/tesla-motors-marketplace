generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CUSTOMER
  ADMIN
}

enum AccountStatus {
  ACTIVE
  SUSPENDED
}

enum VehicleCategory {
  PASSENGER
  COMMERCIAL
  ANNOUNCED
  HISTORICAL
}

enum VehicleCondition {
  NEW
  USED
  CERTIFIED
  SAMPLE
}

enum InventoryStatus {
  AVAILABLE
  RESERVED
  SOLD
  UNAVAILABLE
  CATALOG_ONLY
}

enum ReservationStatus {
  PENDING
  CONFIRMED
  EXPIRED
  CANCELLED
  CONVERTED
}

enum OrderStatus {
  INQUIRY
  PENDING_PAYMENT
  PAID
  PROCESSING
  DELIVERED
  COLLECTED
  CANCELLED
  REFUNDED
}

enum PaymentStatus {
  NONE
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum ChatStatus {
  OPEN
  CLOSED
}

model User {
  id               String         @id @default(cuid())
  email            String         @unique
  passwordHash     String
  fullName         String
  phone            String?
  phoneCountryCode String?
  country          String?
  addressLine1     String?
  addressLine2     String?
  city             String?
  stateRegion      String?
  postalCode       String?
  role             Role           @default(CUSTOMER)
  status           AccountStatus  @default(ACTIVE)
  emailVerified    Boolean        @default(false)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  reservations   Reservation[]
  orders         Order[]
  favorites      Favorite[]
  reviews        Review[]
  auditLogs      AuditLog[]     @relation("AdminActions")
  passwordResets PasswordReset[]
  chatThreads    ChatThread[]
  chatMessages   ChatMessage[]

  @@index([email])
  @@index([role])
}

model PasswordReset {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
}

model Vehicle {
  id              String           @id @default(cuid())
  model           String
  modelYear       Int
  trim            String
  slug            String           @unique
  description     String           @db.Text
  category        VehicleCategory  @default(PASSENGER)
  condition       VehicleCondition @default(SAMPLE)
  exteriorColor   String?
  interiorColor   String?
  vin             String?
  price           Decimal          @db.Decimal(12, 2)
  currency        String           @default("USD")
  depositAmount   Decimal?         @db.Decimal(12, 2)
  inventoryStatus InventoryStatus  @default(CATALOG_ONLY)
  featured        Boolean          @default(false)
  published       Boolean          @default(true)
  driveType       String?
  accel060        String?
  topSpeed        String?
  rangeEpa        Int?
  rangeStandard   String?
  batteryKwh      Float?
  seating         Int?
  horsepower      String?
  torque          String?
  lengthMm        Int?
  widthMm         Int?
  heightMm        Int?
  wheelbaseMm     Int?
  cargoCuFt       Float?
  groundClearance String?
  charging        String?
  safetyRating    String?
  specsJson       Json?
  market          String           @default("US")
  disclaimer      String?          @db.Text
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  images       VehicleImage[]
  reservations Reservation[]
  orders       Order[]
  favorites    Favorite[]
  reviews      Review[]

  @@index([model, modelYear])
  @@index([inventoryStatus, published])
  @@index([featured])
  @@index([price])
}

model VehicleImage {
  id           String  @id @default(cuid())
  vehicleId    String
  url          String
  altText      String
  displayOrder Int     @default(0)
  vehicle      Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@index([vehicleId])
}

model Reservation {
  id            String            @id @default(cuid())
  reference     String            @unique
  userId        String
  vehicleId     String
  depositAmount Decimal           @db.Decimal(12, 2)
  currency      String            @default("USD")
  status        ReservationStatus @default(PENDING)
  paymentStatus PaymentStatus     @default(NONE)
  expiresAt     DateTime?
  notes         String?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  vehicle  Vehicle   @relation(fields: [vehicleId], references: [id])
  payments Payment[]

  @@index([userId])
  @@index([vehicleId])
  @@index([status])
}

model Order {
  id            String        @id @default(cuid())
  reference     String        @unique
  userId        String
  vehicleId     String
  sellingPrice  Decimal       @db.Decimal(12, 2)
  currency      String        @default("USD")
  paymentStatus PaymentStatus @default(NONE)
  orderStatus   OrderStatus   @default(INQUIRY)
  deliveryNotes String?
  internalNotes String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  vehicle  Vehicle   @relation(fields: [vehicleId], references: [id])
  payments Payment[]

  @@index([userId])
  @@index([orderStatus])
}

model Payment {
  id            String        @id @default(cuid())
  orderId       String?
  reservationId String?
  provider      String        @default("manual")
  providerRef   String?
  amount        Decimal       @db.Decimal(12, 2)
  currency      String        @default("USD")
  status        PaymentStatus @default(PENDING)
  createdAt     DateTime      @default(now())

  order       Order?       @relation(fields: [orderId], references: [id])
  reservation Reservation? @relation(fields: [reservationId], references: [id])

  @@index([orderId])
  @@index([reservationId])
}

model Favorite {
  id        String   @id @default(cuid())
  userId    String
  vehicleId String
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  vehicle Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@unique([userId, vehicleId])
}

model Review {
  id        String   @id @default(cuid())
  userId    String
  vehicleId String?
  rating    Int
  body      String   @db.Text
  moderated Boolean  @default(false)
  published Boolean  @default(false)
  createdAt DateTime @default(now())

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  vehicle Vehicle? @relation(fields: [vehicleId], references: [id])

  @@index([published])
}

model SiteContent {
  id        String   @id @default(cuid())
  key       String   @unique
  title     String?
  body      String   @db.Text
  updatedAt DateTime @updatedAt
}

model AuditLog {
  id         String   @id @default(cuid())
  adminId    String
  action     String
  entityType String?
  entityId   String?
  meta       Json?
  createdAt  DateTime @default(now())

  admin User @relation("AdminActions", fields: [adminId], references: [id])

  @@index([adminId])
  @@index([createdAt])
}

model ChatThread {
  id            String     @id @default(cuid())
  userId        String?
  guestName     String?
  guestEmail    String?
  subject       String     @default("Support")
  status        ChatStatus @default(OPEN)
  lastMessageAt DateTime   @default(now())
  createdAt     DateTime   @default(now())

  user     User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  messages ChatMessage[]

  @@index([status, lastMessageAt])
  @@index([userId])
}

model ChatMessage {
  id        String   @id @default(cuid())
  threadId  String
  senderId  String?
  isAdmin   Boolean  @default(false)
  body      String   @db.Text
  createdAt DateTime @default(now())

  thread ChatThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  sender User?      @relation(fields: [senderId], references: [id], onDelete: SetNull)

  @@index([threadId, createdAt])
}
