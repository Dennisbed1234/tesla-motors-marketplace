# Database (Neon / Postgres pooler URL)
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# Auth — generate with: openssl rand -base64 32
JWT_SECRET="change-me-to-a-long-random-string"

# Optional: admin bootstrap (first admin only if no admin exists)
ADMIN_BOOTSTRAP_EMAIL="admin@example.com"
ADMIN_BOOTSTRAP_PASSWORD="ChangeThisStrongPassword!"

# Optional: Resend for transactional email
RESEND_API_KEY=""
RESEND_FROM="Tesla Motors Marketplace <noreply@yourdomain.com>"
ADMIN_NOTIFY_EMAIL=""

# Public site URL
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_NAME="Tesla Motors — Premium EV Marketplace"

# Payments (optional — leave empty to use inquiry-only mode)
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
